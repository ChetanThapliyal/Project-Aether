#!/usr/bin/env bash
# =============================================================================
# GCP DMZ Observability Node — Bootstrap Script
# =============================================================================
# This script is executed once upon initial VM boot via metadata_startup_script.
# Logs are streamed to /var/log/startup-script.log for auditability.
# =============================================================================

set -euo pipefail

exec > >(tee -a /var/log/startup-script.log) 2>&1
echo "=== [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Starting DMZ Bootstrap ==="

export DEBIAN_FRONTEND=noninteractive

# 1. Update package lists and install essential utilities
echo "--- Updating package repositories and installing base packages ---"
apt-get update -y
apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    ufw \
    jq \
    htop

# 2. Install Docker Engine via official script (ensures distro compatibility)
if ! command -v docker &> /dev/null; then
    echo "--- Installing Docker Engine ---"
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
else
    echo "--- Docker is already installed ---"
fi

# Add the provisioned user to the docker group
if id "${ssh_user}" &>/dev/null; then
    echo "--- Adding user ${ssh_user} to docker group ---"
    usermod -aG docker "${ssh_user}" || true
fi

# 3. Install Tailscale
if ! command -v tailscale &> /dev/null; then
    echo "--- Installing Tailscale ---"
    curl -fsSL https://tailscale.com/install.sh | sh
    systemctl enable --now tailscaled
else
    echo "--- Tailscale is already installed ---"
fi

# Authenticate Tailscale if key is provided
%{ if tailscale_auth_key != "" }
echo "--- Registering node with Tailscale network ---"
tailscale up \
    --authkey="${tailscale_auth_key}" \
    --hostname="${hostname}" \
    --ssh \
    --accept-routes=true
%{ else }
echo "--- Notice: tailscale_auth_key was not supplied. Manual 'tailscale up' required ---"
%{ endif }

# 4. Prepare directory layout for Docker Compose DMZ services (Uptime Kuma, Homepage, Cloudflared)
echo "--- Preparing /opt/dmz directory structure ---"
mkdir -p /opt/dmz
if id "${ssh_user}" &>/dev/null; then
    chown -R "${ssh_user}:${ssh_user}" /opt/dmz
fi
chmod 750 /opt/dmz

echo "=== [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] DMZ Bootstrap Completed Successfully ==="
